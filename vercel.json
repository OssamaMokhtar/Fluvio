{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run build:node",
  "outputDirectory": "dist",
  "functions": {
    "api/index.cjs": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.cjs" }
  ]
}
