{
  "name": "slang",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/api/index.ts",
    "build": "vite build",
    "start": "node api/index.cjs",
    "preview": "vite preview",
    "build:node": "esbuild src/api/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/index.cjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run test && node scripts/verify-claims.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.577.0",
    "openai": "^4.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
